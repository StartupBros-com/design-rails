#!/usr/bin/env node
// design-rails dispatcher: posture | scan | propose | decide | tighten
// Each verb is a self-contained dependency-free script; this file only routes.
import { spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const src = join(dirname(fileURLToPath(import.meta.url)), "..", "src");
const [verb, ...rest] = process.argv.slice(2);

const VERBS = {
  posture: "posture.mjs",
  scan: "scan.mjs",
  propose: "propose.mjs",
  decide: "decide.mjs",
  // tighten is a scan mode: `design-rails tighten <file> [root]`
  tighten: null,
};

if (!verb || !(verb in VERBS)) {
  console.error(`design-rails — guardrails that keep AI agents on YOUR design

usage:
  design-rails posture <app-or-workspace-root>   five-check pass/fail table
  design-rails scan <root> [--json] [--fail-on=…] drift measurement + CI gate
  design-rails propose <app> [--mode=dark] [--out=design/]  author DESIGN.md + tokens
  design-rails decide <app> [--record slug=option]          visual decision pages
  design-rails tighten <budgets-file> [root]     lower CI budgets to actuals`);
  process.exit(verb ? 2 : 0);
}

const argv =
  verb === "tighten"
    ? [join(src, "scan.mjs"), rest[1] || ".", `--tighten=${rest[0]}`]
    : [join(src, VERBS[verb]), ...rest];
const r = spawnSync(process.execPath, argv, { stdio: "inherit" });
process.exit(r.status ?? 1);
